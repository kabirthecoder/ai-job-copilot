# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — increases GitHub API rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=your_github_token_here

# Vector store path (default: ~/.devmind/store)
DEVMIND_STORE_PATH=~/.devmind/store

# LLM model (default: gemini-2.5-flash)
DEVMIND_MODEL=gemini-2.5-flash
